--apple
function iap()
	ap={
	x=20,
	y=20
	}
end

function uap()
	tap(pl, ap)
end

--draw apple
function dap()
	spr(2,ap.x,ap.y)
end


-->8
function tap(o, g)
	if collition1(o) then
			g.x = 80
			g.y = 80
	end
end

--collition apple o=pl, o2=ap
function collition1(o)
--player location
	local x1 = (o.x + 2) / 8
	local y1 = (o.y + 0) / 8
	local x2 = (o.x + 5) / 8
	local y2 = (o.y + 7) / 8
--apple location
--	local ax1 =	(o2.x + 0) / 8
--	local ay1 = (o2.y + 0) / 8
--	local ax2 = (o2.x + 0) / 8
--	local ay2 = (o2.y + 0) / 8

	local a = fget(mget(x1,y1),1)
	local b = fget(mget(x1,y2),1)
	local c = fget(mget(x2,y2),1)
	local d = fget(mget(x2,y1),1)
	
	if a or b or c or d then
		return true
	else
		return false
	end
	
end
