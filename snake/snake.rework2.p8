version 43
__lua__
function _init()
	ipl()
	iap()
end

function _update60()
	upl()
	uap()
end

function _draw()
	cls(1)
	map()
	dpl()
	dap()
end
-->8
--player
function ipl()
	pl={
	x=60,
	y=85
	}
end

function upl()
	move(pl)
	map_end(pl)
end
 
function dpl()
	spr(1,pl.x,pl.y)
end

	
-->8
--player move, collition, 
--map boundry
function move(o)
	local lx = o.x
	local ly = o.y
	
	local nx = 60
	local ny = 60
	
	
	if (btn(0)) o.x -= 1
	if (btn(1)) o.x += 1
	if (btn(2)) o.y -= 1
	if (btn(3)) o.y += 1
	--block
	if collition0(o) then
		o.x = lx
		o.y = ly
	end
	
--	if collition1(o) then
--		ap.x = nx
--		ap.y = ny
--	end
		
end
--collition block
function collition0(o)
	local x1 = (o.x + 2) / 8
	local y1 = (o.y + 0) / 8
	local x2 = (o.x + 5) / 8
	local y2 = (o.y + 7) / 8
	
	local a = fget(mget(x1,y1),0)
	local b = fget(mget(x1,y2),0)
	local c = fget(mget(x2,y2),0)
	local d = fget(mget(x2,y1),0)
	
	if a or b or c or d then
		return true
	else
		return false
	end
	
end

--teleport to the map end
function map_end(o)
	if o.x < 0 then
			o.x = 128
	end
	if o.x > 128 then
			o.x = 0
	end
	if o.y < 0 then
			o.y = 128
	end
	if o.y > 128 then
			o.y = 0
	end
	
end
