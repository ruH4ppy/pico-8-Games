pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
		a1x,a1y = 40,20
		a2x,a2y = 50,30
		
		b1x,b1y = 50,50
		b2x,b2y = 60,60
		
		check = 0
end

function _update()
--movement player
		if btn(0) then
				a1x -= 1
				a2x -= 1
		end
		
		if btn(1) then
				a1x += 1
				a2x += 1
		end
		
		if btn(2) then
				a1y -= 1
				a2y -= 1
		end
		
		if btn(3) then
				a1y += 1
				a2y += 1
		end

end

function _draw()
		cls(1)
		rect(a1x,a1y,a2x,a2y,14)
		
		if check < 1 then
				rect(b1x,b1y,b2x,b2y,7)
		else 
				print("cleared",50,40,11)				
		end
		
			if a1x > b2x then
				print("ok",50,20,11)
				print(check,50,30,11)
			--	check = 0
		elseif a1y > b2y then
				print("ok",50,20,11)
				print(check,50,30,11)
			--	check = 0
		elseif a2x < b1x then
				print("ok",50,20,11)
				print(check,50,30,11)
			--	check = 0
		elseif a2y < b1y then
				print("ok",50,20,11)
				print(check,50,30,11)
			--	check = 0
		else 
				print("not ok",50,20,8)
				print(check,50,30,11)
				check = 1
				sfx(0)
				b1x,b1y,b2x,b2y=0,0,0,0
		end

--		if 				a1x > b2x then
--				print("ok",40,25,11)
--		elseif a2x < b1x then
--				print("ok",40,25,11)
--		elseif a1y > b2y then
--				print("ok",40,25,11)
--		elseif a2y < b1y then
--				print("ok",40,25,11)
--		else
--				print("not ok",40,25,8)
--				sfx(0)
--		end		
		
end
