pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
	x = 50
	y = 100
	plsp = 2
	bx = x
	by = y
end

--move in 8 diractions
function _update60()
	 
		if (btn(0)) x -= 2 --bx -= 1
		if (btn(1)) x += 2 --bx += 1
		if (btn(2)) y -= 2 --by -= 1
		if (btn(3)) y += 2 --by += 1
	
		if x > 128 then
				x = -5
		elseif x < -5 then
				x = 128 
		end
		
		if y > 128 then
				y = -5
		elseif y < -5 then
				y = 128
		end
--	if btn(5)
--	if (btn(❎)) y -= 4
	
	--gravity
--	if y < 120 then
--		y += 0.3
--	end
	
	--sprite frame cycle
	if (plsp < 4.9) then
	 plsp += 0.1
	else 
		plsp = 1
	end 
	
end

--clear screen + draw sprit
function _draw()
		cls(1)
		spr(plsp,x,y)

		if btn(5) then		

--				for i=1,5 do
						circfill(bx+5,by+4,1,13)
						bx += 2
--				end
		
		if bx > 128 then
				bx = x by = y
		end		
						
end

	--camera(x-50,y-20)
end
