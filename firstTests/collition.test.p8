pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
		a1x,a2x = 40,50
		a1y,a2y = 20,30
end

function _update()
		if btn(0) then
				a1x -= 1
				a2x -= 1
		end
		
		if btn(1) then
				a1x += 1
				a2x += 1
		end
		
		if btn(2) then
				a1y -= 1
				a2y -= 1
		end
		
		if btn(3) then
				a1y += 1
				a2y += 1
		end
				
		
end

function _draw()
		cls(1)
		rect(a1x,a1y,a2x,a2y,14)
		
end

