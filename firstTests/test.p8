pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
	x = 50
	y = 100
	plsp = 2
end

--move in 8 diractions
function _update60()
	 
	if (btn(0)) x -= 1
	if (btn(1)) x += 1
	if (btn(2)) y -= 1 
	if (btn(3)) y += 1
	if (btn(❎)) y -= 5 
	
	--gravity
	if y < 120 then
		y += 0.3
	end
	
	--sprite frame cycle
	if (plsp < 4.9) then
	 plsp += 0.1
	else 
		plsp = 1
	end 
	
end

--clear screen + draw sprit
function _draw()
	cls(1)
	spr(plsp,x,y)
	--camera(x-50,y-20)
end
