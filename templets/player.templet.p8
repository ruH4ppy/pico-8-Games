pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
	ipl()
end

function _update()
	upl()
end

function _draw()
	cls(1)
	dpl()
end
-->8
--player
function ipl()
	pl={
	x=50,
	y=75,
	hp=100
	}
end

function upl()
	if btn(0) then
		pl.x-=1
	end
	if btn(1) then
		pl.x+=1
	end
	if btn(2) then
		pl.y-=1
	end
	if btn(3) then
		pl.y+=1
	end
end

function dpl()
	spr(1,pl.x,pl.y)
end
