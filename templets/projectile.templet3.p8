pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
--main functions
function _init()
	ipl()
	iproj()
	iene()
end

function _update()
	upl()
	uproj()
	uene()
end

function _draw()
	cls(1)
	print("player hp:")
	print(pl.hp)
	dpl()
	dproj()
	dene()
		
	--debug
	print(#projr)
	print(#projl)
end
-->8
--player
function ipl()
	pl={
	x=63,
	y=63,
	hp=100,
	d=0
	}
end

function upl()
	--pl movement
	if btn(0) then
		pl.x-=1
		pl.d=0
	end
	if btn(1) then
		pl.x+=1
		pl.d=1
	end
	if btn(2) then
		pl.y-=1
	end
	if btn(3) then
		pl.y+=1
	end
	--pl shoot
	if btnp(❎) then
		shoot()
	end
end

function dpl()
	spr(1,pl.x,pl.y)
end
-->8
--projectile
function iproj()
	projr={}
	projl={}
end

function uproj()
		--move proj left and right
		--delete if off screen
		for p in all(projl) do
			p.x=p.x-2
				if p.x>128 or	p.x<0 then
					del(projl,p)
				end
		end
	
		for p in all(projr) do
			p.x=p.x+2
				if p.x>128 or	p.x<0 then
					del(projr,p)
				end
		end
	
end

function dproj()
	--draw proj left + right
	for p in all(projl) do
		spr(3,p.x,p.y)
	end
	for p in all(projr) do
		spr(2,p.x,p.y)
	end
end

function shoot()
	--shoot left
	if pl.d==0 then
		add(projl,{
			x=pl.x-4,
			y=pl.y,
			dmg=5
		})
	end
	--shoot right
	if pl.d==1 then
		add(projr,{
			x=pl.x+4,
			y=pl.y,
			dmg=5
		})
	end
end
-->8
--enemy
function iene()
	ene={}
	
	add(ene,{x=100,y=60,hp=10})
end

function uene()
	for e in all(ene) do
		--collition projr
		for p in all(projr) do
			if abs(e.x-p.x)<8 and
						abs(e.y-p.y)<8 then
				e.hp=e.hp-p.dmg
				del(projr,p)
			end
		end
		--collition projl
		for p in all(projl) do
			if abs(e.x-p.x)<8 and
						abs(e.y-p.y)<8 then
				e.hp=e.hp-p.dmg
				del(projl,p)
			end
		end
		--delete enemy when hp is 0
		if e.hp<=0 then
						del(ene,e)
		end
	end
	
end

function dene()
	--draw all enemies
	for e in all(ene) do
		spr(17,e.x,e.y)
	end
	
end
