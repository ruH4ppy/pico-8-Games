pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
	ipl()
	iproj()
end

function _update()
	upl()
	uproj()
end

function _draw()
	cls(1)
	dpl()
	dproj()
	
	--debug
	print(#projr)
	print(#projl)
end
-->8
--player
function ipl()
	pl={
	x=50,
	y=75,
	hp=100
	}
	dirc=0
end

function upl()
	if btn(0) then
		pl.x-=1
		dirc=0
	end
	if btn(1) then
		pl.x+=1
		dirc=1
	end
	if btn(2) then
		pl.y-=1
	end
	if btn(3) then
		pl.y+=1
	end
	
	if btnp(❎) then
		shoot()
	end
end

function dpl()
	spr(1,pl.x,pl.y)
end
-->8
--projectile
function iproj()
	projr={}
	projl={}
end

function uproj()
		for p in all(projr) do
			p.x=p.x-1
				if p.x>128 or	p.x<0 then
					del(projr,p)
				end
		end
	
		for p in all(projl) do
			p.x=p.x+1
				if p.x>128 or	p.x<0 then
					del(projl,p)
				end
		end
	
end

function dproj()
	for p in all(projr) do
		spr(3,p.x,p.y)
	end
	for p in all(projl) do
		spr(2,p.x,p.y)
	end
end

function shoot()
	if dirc==0 then
		add(projr,{
			x=pl.x,
			y=pl.y
		})
	end
	if dirc==1 then
		add(projl,{
			x=pl.x,
			y=pl.y
		})
	end
end
