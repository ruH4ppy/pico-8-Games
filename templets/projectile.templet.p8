pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
	ipl()
	iproj()
end

function _update()
	upl()
	uproj()
end

function _draw()
	cls(1)
	dpl()
	dproj()
end
-->8
--player
function ipl()
	pl={
	x=50,
	y=75,
	hp=100
	}
end

function upl()
	if btn(0) then
		pl.x-=1
	end
	if btn(1) then
		pl.x+=1
	end
	if btn(2) then
		pl.y-=1
	end
	if btn(3) then
		pl.y+=1
	end
	
	if btnp(❎) then
		shoot()
	end
end

function dpl()
	spr(1,pl.x,pl.y)
end
-->8
--projectile
function iproj()
	proj={}
end

function uproj()
	for p in all(proj) do
		p.x=p.x+1
		if p.x>128 or	p.x<0 then
			del(proj,p)
		end
	end
end

function dproj()
	for p in all(proj) do
		spr(2,p.x,p.y)
	end
end

function shoot()
	add(proj,{
		x=pl.x,
		y=pl.y
	})
end
