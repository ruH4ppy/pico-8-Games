__lua__
function _init()
	ipl()
	ipu()
	iene()
	ipla()
	backup={}
	score=0
	game=0
	tick=0
end

function _update()
	upl()
	camera(pl.x-55,5)
	upu()
	uene()
	upla()
	
	if tick<7 then
		tick+=1
	else
		tick=0
	end
	
end
	
function _draw()
	cls()
	map(1)
	dpu()
	dene()
	dpla()
	
	dpl()
	
	print(pl.dx,pl.x-55,pl.y-80)
	print(onground(pl))
	print(collide(pl))
	print(pl.dy)
	print(score)
	print(tick)
--	for e in all(ene) do
--		print(e.d)
--	end
end

