--player
function ipl()
	pl={
	x=45,
	y=80,
	dx=0,
	dy=0,
	max_dx=8,
	max_dy=10,
	acc=0.5,
	jump=12,
	d=1,
	dt=1,
	da=0,
	dash=5,
	act=true
	}
	
	friction=0.7
	gravity=2.5
	--gravity=0
end

function upl()
	move(pl,pla,tick)
end

function dpl()
	if pl.act then
		spr(1,pl.x,pl.y)
	end
end

