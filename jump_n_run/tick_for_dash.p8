--player movement + collision
function move(o,p,t)
 
 local lx=o.x
	local ly=o.y
	
	o.y+=gravity
	o.dx*=friction
	
	if (btn(0)) o.dx-=o.acc o.d=-1
	if (btn(1)) o.dx+=o.acc	o.d=1
	
	if btnp(4) and o.dt>=1 then
		o.dx+=o.dash*o.d
	 o.dt-=1
	end
	
	--moving platform wird zum
	--trampolin kek
--	if btnp(5) and 
--				onground(o) or 
--				pla_collision(o,p) then
--		o.dy-=o.jump
--	end

	if btnp(5) and 
	onground(o) then
		o.dy-=o.jump
	elseif btnp(5) and 
	pla_collision(o,p) then
		o.dy-=o.jump
	end
	
	o.y+=o.dy
	o.x+=o.dx
	
	if onground(o,t) then
		o.y=ly
	end
	
	if	pla_collision(o,p) then
		o.y=ly
	end
	
	if collide(o) then
		o.x=lx
	end
	
	o.dx=(mid(-o.max_dx,o.dx,
										o.max_dx))
	
	if (o.dy<0) then
		o.dy=(mid(-o.max_dy,o.dy,
												o.max_dy))*0.8
	end
	
end

function onground(o,t)
	local	x1=(o.x+3)/8
	local	y1=(o.y+6)/8

	if fget(mget(x1,y1),0) then
		o.dy=0
		if t==7 then
			o.dt=1
		end
		return true
	else
		return false
	end
	
end

function collide(o)
	local	x1=(o.x+10)/8
	local	y1=(o.y)/8
	local	x2=(o.x+12)/8
	local	y2=(o.y+5)/8
	
	local a=fget(mget(x1,y1),1)
	local b=fget(mget(x1,y2),1)
	local c=fget(mget(x2,y2),1)
	local d=fget(mget(x2,y1),1)
	
	if a or b or c or d then
		return true
	else
		return false
	end
	
end
-->8
--pick up
function ipu()
	pu={}
	spawn_obj(21,pu)
end

function upu()
	for p in all(pu) do
	 if p.act then
			if abs(pl.x-p.x)<=4 and
						abs(pl.y-p.y)<=4 then
				p.act=false
				score+=1
			end
		end
	end
end

function dpu()
	for p in all(pu) do
		if p.act then
			spr(20,p.x,p.y)
		end
	end
end



-->8
--enemies
function iene()
	ene={}
	spawn_obj(5,ene)
end

function uene()
	for e in all(ene) do
	 if e.act then
			if abs(pl.x-e.x)<=4 and
						abs(pl.y-e.y)<=3 then
				pl.act=false
			end
		end
	end
	
	move_obj(ene,40,0.5)
end

function dene()
	for e in all(ene) do
		if e.act then
			spr(4,e.x,e.y)
		end
	end
end

function move_obj(o,d,v)
	for e in all(o) do
		if e.act then
			--move in diriction
			if e.d==0 then
				e.x-=v
			else
				e.x+=v
			end
			--change diriction at
			--spawnx +d and -d
			if e.x<e.sx-d then
				e.d=1
			elseif e.x>e.sx+d then
				e.d=0
			end
		end
	end
end
-->8
--moving platform
function ipla()
	pla={}
	spawn_obj(34,pla)
end

function upla()
	move_obj(pla,20,0.4)
end

function dpla()
	for e in all(pla) do
		rectfill(e.x,e.y+3,
											e.x+7,e.y+4,2)
		spr(33,e.x,e.y)
	end
end

function spawn_obj(s,o)
	for x=0,34 do
		for y=0,18 do
			if mget(x,y)==s then
				add(backup,{
					ox=x,
					oy=y,
					sp=s
				})
				
				mset(x,y,0) 

				add(o,{
					x=x*8,
					sx=x*8,
					y=y*8,
					d=0,
					act=true
					})
			end
		end
	end
end--spawn end

function pla_collision(o,p)
	for i in all(p) do
		if abs(o.x-i.x)<=4 and
		abs(o.y-i.y)<=3 then
			o.dt+=1
		 return true
		end	
	end
end
