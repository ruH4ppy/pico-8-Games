pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
	ipl()
	ipu()
	iene()
	spawn_pu()
	spawn_ene()
	score=0
	game=0
end

function _update()
	upl()
	camera(pl.x-55,5)
	upu()
	uene()
	
end

function _draw()
	cls()
	map(1)
	dpu()
	dene()
	dpl()
	
	print(onground(pl))
	print(collide(pl))
	print(pl.dx)
	print(pl.dy)
	print(score)
	
	for e in all(ene) do
		print(e.d)
	end
end
-->8
--player
function ipl()
	pl={
	x=45,
	y=80,
	dx=0,
	dy=0,
	max_dx=2,
	max_dy=10,
	acc=0.5,
	boost=10,
	act=true
	}
	
	friction=0.7
	gravity=2.5
	--gravity=0
end

function upl()
	move(pl)
end

function dpl()
	if pl.act then
		spr(1,pl.x,pl.y)
	end
end
-->8
--player movement + collision
function move(o)
 
 local lx=o.x
	local ly=o.y
	
	o.y+=gravity
	o.dx*=friction
	
	if (btn(0)) o.dx-=o.acc
	if (btn(1)) o.dx+=o.acc
	if btnp(5) and onground(o) then
		o.dy-=o.boost
	end
	
	o.y+=o.dy
	o.x+=o.dx
	
	if onground(o) then
		o.y=ly
	end
	
	if collide(o) then
		o.x=lx
	end

	
	o.dx=mid(-o.max_dx,o.dx,
										o.max_dx)
	
	if (o.dy<0) then
		o.dy=(mid(-o.max_dy,o.dy,
												o.max_dy))*0.8
	end
	
end

function onground(o)
	local	x1=(o.x+3)/8
	local	y1=(o.y+6)/8
	
	local a=fget(mget(x1,y1),0)

	if a then
		o.dy=0
		return true
	else
		return false
	end
	
end

function collide(o)
	local	x1=(o.x+10)/8
	local	y1=(o.y)/8
	local	x2=(o.x+12)/8
	local	y2=(o.y+5)/8
	
	local a=fget(mget(x1,y1),1)
	local b=fget(mget(x1,y2),1)
	local c=fget(mget(x2,y2),1)
	local d=fget(mget(x2,y1),1)
	
	if a or b or c or d then
		return true
	else
		return false
	end
	
end
-->8
--pick up
function ipu()
	pu={}
end

function spawn_pu()
	add(pu,{x=20,y=110,act=true})
end

function upu()
	for p in all(pu) do
	 if p.act then
			if abs(pl.x-p.x)<=4 and
						abs(pl.y-p.y)<=4 then
				p.act=false
				score+=1
			end
		end
	end
end

function dpu()
	for p in all(pu) do
		if p.act then
			spr(20,p.x,p.y)
		end
	end
end



-->8
--enemies
function iene()
	ene={}
end

function spawn_ene()
	add(ene,{x=80,sx=80,y=112,
					d=0,act=true})
end

function uene()
	for e in all(ene) do
	 if e.act then
			if abs(pl.x-e.x)<=4 and
						abs(pl.y-e.y)<=3 then
				pl.act=false
			end
		end
	end
	
	ene_move(ene)
end

function dene()
	for e in all(ene) do
		if e.act then
			spr(4,e.x,e.y)
		end
	end
end

function ene_move(o)
	for e in all(o) do
		if e.act then
			--move in diriction
			if e.d==0 then
				e.x-=0.5
			else
				e.x+=0.5
			end
			--change diriction at
			--spawnx +40 and -40
			if e.x<e.sx-40 then
				e.d=1
			elseif e.x>e.sx+40 then
				e.d=0
			end
		end
	end
end
