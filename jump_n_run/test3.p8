pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
	ipl()
end

function _update()
	upl()
end

function _draw()
	cls()
	map(1)
	dpl()
	
	print(collidey(pl))
	print(collidex(pl))
	print(pl.dx)
	print(pl.dy)
end
-->8
--player
function ipl()
	pl={
	x=10,
	y=80,
	dx=0,
	dy=0,
	max_dx=2,
	max_dy=1,
	acc=0.5,
	boost=4
	}
	
	friction=0.7
	gravity=2
end

function upl()
	move(pl)
end

function dpl()
	spr(1,pl.x,pl.y)
end
-->8
--player movement
function move(o)
	
	local lx=o.x
	local ly=o.y
	
	if collidey(o)==false then 
		o.y+=gravity
	end
	
	o.dx*=friction
		
	if (btn(0)) o.dx-=o.acc
	if (btn(1)) o.dx+=o.acc
	if btn(5) and collidey(o) then
		o.dy-=o.boost
	end
	
	
	o.x+=o.dx
	o.y+=o.dy
	
	o.dx=mid(-o.max_dx,o.dx,o.max_dx)
	
	if o.dy<0 then
		o.dy=mid(-o.max_dy,o.dy,o.max_dy)
	end
	
	
	if collidey(o) then
		o.y=ly
	end
	
	if collidex(o) then
		o.x=lx
	end

end

function collidey(o)
	local	x1=(o.x+0)/8
	local	y1=(o.y+0)/8
	local	x2=(o.x+7)/8
	local	y2=(o.y+7)/8
	
--	local a=fget(mget(x1,y1),0)
	local b=fget(mget(x1,y2),0)
--	local c=fget(mget(x2,y2),0)
--	local d=fget(mget(x2,y1),0)
	
	if a or b or c or d then
		return true
	else
		return false
	end
	
end

function collidex(o)
	local	x1=(o.x+13)/8
	local	y1=(o.y+0)/8
	local	x2=(o.x+7)/8
	local	y2=(o.y+7)/8
	
	local a=fget(mget(x1,y1),1)
	local b=fget(mget(x1,y2),1)
	local c=fget(mget(x2,y2),1)
	local d=fget(mget(x2,y1),1)
	
	if a or b or c or d then
		return true
	else
		return false
	end
	
end

